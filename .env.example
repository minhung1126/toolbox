# ==============================================================================
# Toolbox 最小環境設定範本 (.env.example)
# ==============================================================================
# Toolbox 採用「反向代理網址經由 .env 傳遞，其餘設定全面由網頁控制台管理」：
#
# 1. 反向代理公開網址 (PUBLIC_BASE_URL)：指定外部存取網域，用於建置 Google OAuth Redirect URI。
# 2. 系統主金鑰 (SECRET_KEY, CREDENTIAL_ENCRYPTION_KEY)：首次啟動自動生成並安全保存於 data/.secrets.json。
# 3. Google OAuth 憑證、管理者白名單與 YouTube 雙槽位：由初始化精靈 (/setup) 或網頁控制台配置。
# ==============================================================================

PUBLIC_BASE_URL=https://toolbox.example.com


